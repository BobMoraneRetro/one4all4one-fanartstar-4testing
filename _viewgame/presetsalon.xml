<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${boitiercouleur} : couleur du boîtier selon le système (shader border_dvd_case) (définie dans _viewgameoption/gl-common/boitiers_systemes.xml)
	${boitiertype} : type de boîtier selon le système (shader border_dvd_case : DVD, CD, cartouche...) (définie dans _viewgameoption/gl-common/boitiers_systemes.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${media_box2d} : boîte 2D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box2d_missing} : vrai si le média « box2d » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d} : boîte 3D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d_missing} : vrai si le média « box3d » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_image} : capture du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee} : logo du jeu (marquee) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee_missing} : vrai si le média « marquee » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_support} : support physique du jeu (cartouche, ou disque pour les systèmes à disque) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_support_exists} : vrai si le média « support » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video} : vidéo du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video_exists} : vrai si le média « video » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${salon_defaut} : vue Salon : décor et réglages par défaut, _default (systèmes 4:3) ou _default16 (systèmes 16:9 listés) (définie dans ce fichier)
	${salon_disque_depart} : vue Salon : x du disque caché derrière la boîte sélectionnée (définie dans ce fichier)
	${salon_disque_taille} : vue Salon : taille maximale du disque (définie dans ce fichier)
	${salon_disque_tourne} : vue Salon : true = le disque tourne (systèmes CD/DVD par défaut), false = il sort sans tourner ; réglable par <système>.xml (définie dans ce fichier)
	${salon_disque_x} : vue Salon : x du disque une fois sorti de la boîte (définie dans ce fichier)
	${salon_disque_y} : vue Salon : hauteur du centre du disque (définie dans ce fichier)
	${salon_video_pos} : vue Salon : centre de l écran de la TV (vidéo sous le décor) (définie dans ce fichier)
	${salon_video_taille} : vue Salon : largeur hauteur de l écran de la TV (définie dans ce fichier)
	${starespace2d} : Boxart : écart entre les boîtes 2d du carrousel (définie dans _viewgame/deck/espacement/ : un fichier par choix de l option « JEUX - Espacement des boîtes »)
	${starespace3d} : Boxart : écart entre les boîtes 3d du carrousel (définie dans _viewgame/deck/espacement/ : un fichier par choix de l option « JEUX - Espacement des boîtes »)
	${starlogos2d} : Boxart (presetstarbox, carrousel) : nombre de boîtes affichées et écart, boîtes 2D puis 3D (définie dans _viewgame/deck/espacement/ : un fichier par choix de l option « JEUX - Espacement des boîtes »)
	${starlogos3d} : Boxart : nombre de boîtes 3d affichées (définie dans _viewgame/deck/espacement/ : un fichier par choix de l option « JEUX - Espacement des boîtes »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${presetsalon}
-->
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<salon_video_pos>0.5 0.2625</salon_video_pos>
		<salon_video_taille>0.3906 0.388</salon_video_taille>
		<salon_disque_depart>0.5</salon_disque_depart>
		<salon_disque_x>0.69</salon_disque_x>
		<salon_disque_y>0.65</salon_disque_y>
		<salon_disque_taille>0.36 0.64</salon_disque_taille>
		<salon_disque_tourne>false</salon_disque_tourne>
		<salon_disque_tourne if="{system.theme} == 'psx' || {system.theme} == 'ps2' || {system.theme} == 'ps3' || {system.theme} == 'saturn' ||
					{system.theme} == 'megacd' || {system.theme} == 'dreamcast' || {system.theme} == '3do' || {system.theme} == 'cdi' || {system.theme} == 'amigacd32' ||
					{system.theme} == 'amigacdtv' || {system.theme} == 'neogeocd' || {system.theme} == 'pcenginecd' || {system.theme} == 'pcfx' || {system.theme} == 'jaguarcd' ||
					{system.theme} == 'gamecube' || {system.theme} == 'wii' || {system.theme} == 'xbox' || {system.theme} == 'xbox360' || {system.theme} == 'fmtowns'">true</salon_disque_tourne>
		<salon_defaut>_default</salon_defaut>
		<salon_defaut if="{system.theme} == 'ps3' || {system.theme} == 'ps4' || {system.theme} == 'ps5' || {system.theme} == 'xbox360' || {system.theme} == 'xboxone' || {system.theme} == 'xboxseries' || {system.theme} == 'wiiu' || {system.theme} == 'switch' || {system.theme} == 'psvita' || {system.theme} == 'windows' || {system.theme} == 'steam'">_default16</salon_defaut>
	</variables>
	<include>${themePath}/_gamemedia/_salon/${salon_defaut}.xml</include>
	<include>${themePath}/_gamemedia/_salon/${system.theme}.xml</include>
	<customView name="presetsalon" displayName="${presetsalon}" inherits="gamecarousel">
		<control name="fanart_extra,screenshot_extra,video_extra">
			<visible>false</visible>
		</control>
		<image name="md_image">
			<visible>false</visible>
		</image>
		<image name="gamecarouselLogo">
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="salonfond" extra="true">
			<path>firstfile("${themePath}/_gamemedia/_salon/" + {system:theme} + ".png", "${themePath}/_gamemedia/_salon/${salon_defaut}.png")</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<linearSmooth>true</linearSmooth>
			<zIndex>5</zIndex>
		</image>
		<image name="salonnoir" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>${themePath}/_viewgame/salon/noir.png</path>
			<pos>${salon_video_pos}</pos>
			<origin>0.5 0.5</origin>
			<size>${salon_video_taille}</size>
			<zIndex>2.5</zIndex>
		</image>
		<image name="salonimage" extra="true">
			<visible>!(${media_video_exists}) &amp;&amp; {game:rom} != '..'</visible>
			<path>${media_image}</path>
			<pos>${salon_video_pos}</pos>
			<origin>0.5 0.5</origin>
			<maxSize>${salon_video_taille}</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>2.8</zIndex>
		</image>
		<video name="salonvideo" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>${media_video}</path>
			<delay>0</delay>
			<pos>${salon_video_pos}</pos>
			<origin>0.5 0.5</origin>
			<maxSize>${salon_video_taille}</maxSize>
			<effect>none</effect>
			<zIndex>3</zIndex>
		</video>
		<gamecarousel name="gamecarousel">
			<zIndex>10</zIndex>
			<type>horizontal</type>
			<pos>-0.1 0.1</pos>
			<pos ifHelpPrompts="true">-0.1 0.08</pos>
			<size>1.45 1</size>
			<logoScale>1.5</logoScale>
			<logoSize>0.350 0.350</logoSize>
			<color>00000000</color>
			<logoAlignment>bottom</logoAlignment>
			<minLogoOpacity>1</minLogoOpacity>
			<transitionSpeed ifSubset="boxstarspeed:starslow2">2000</transitionSpeed>
			<transitionSpeed ifSubset="boxstarspeed:starslow1">1500</transitionSpeed>
			<transitionSpeed ifSubset="boxstarspeed:stardefault">750</transitionSpeed>
			<logoPos>0.15 0.5</logoPos>
			<imageSource>thumbnail</imageSource>
			<defaultTransition>instant</defaultTransition>
			<maxLogoCount ifSubset="boxorthumb:boxart">${starlogos3d}</maxLogoCount>
			<maxLogoCount ifSubset="boxorthumb:thumb">${starlogos2d}</maxLogoCount>
			<scaledLogoSpacing ifSubset="boxorthumb:boxart">${starespace3d}</scaledLogoSpacing>
			<scaledLogoSpacing ifSubset="boxorthumb:thumb">${starespace2d}</scaledLogoSpacing>
			<itemTemplate>
				<container>
					<image name="salondisque" if="${salon_disque_tourne}">
						<visible>${media_support_exists}</visible>
						<path>${media_support}</path>
						<pos>${salon_disque_depart} ${salon_disque_y}</pos>
						<origin>0.5 0.5</origin>
						<maxSize>${salon_disque_taille}</maxSize>
						<linearSmooth>true</linearSmooth>
						<opacity>0</opacity>
						<storyboard event="activate">
							<animation property="opacity" from="0" to="1" begin="350" duration="250" mode="linear"/>
							<animation property="x" from="${salon_disque_depart}" to="${salon_disque_x}" begin="350" duration="550" mode="easeOut"/>
							<animation property="rotation" from="0" to="90" begin="600" duration="4000" mode="EaseIn"/>
							<animation property="rotation" from="-270" to="90" begin="4600" duration="8000" mode="linear" repeat="forever"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="0" duration="0"/>
							<animation property="x" to="${salon_disque_depart}" duration="0"/>
							<animation property="rotation" to="0" duration="0"/>
						</storyboard>
					</image>
					<image name="saloncartouche" if="!${salon_disque_tourne}">
						<visible>${media_support_exists}</visible>
						<path>${media_support}</path>
						<pos>${salon_disque_depart} ${salon_disque_y}</pos>
						<origin>0.5 0.5</origin>
						<maxSize>${salon_disque_taille}</maxSize>
						<linearSmooth>true</linearSmooth>
						<opacity>0</opacity>
						<storyboard event="activate">
							<animation property="opacity" from="0" to="1" begin="350" duration="250" mode="linear"/>
							<animation property="x" from="${salon_disque_depart}" to="${salon_disque_x}" begin="350" duration="550" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="0" duration="0"/>
							<animation property="x" to="${salon_disque_depart}" duration="0"/>
							<animation property="rotation" to="0" duration="0"/>
						</storyboard>
					</image>
					<image name="thumbnailjp" if="{system.theme} != 'snes' &amp;&amp; {system.theme} != 'n64' &amp;&amp; {system.theme} != 'gameandwatch' &amp;&amp; {system.theme} != 'solarus' &amp;&amp; {system.theme} != 'ngage'">
						<pos>0.5 0.6</pos>
						<origin>0.5</origin>
						<maxSize>0.38 1</maxSize>
						<path>${media_box2d}</path>
						<path ifSubset="boxorthumb:boxart">${media_box3d}</path>
						<path ifSubset="boxorthumb:thumb">${media_box2d}</path>
						<storyboard ifSubset="starboxang:deactive" event="activate">
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:deactive" event="deactivate">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="activate">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="deactivate">
							<animation property="rotation" to="0" begin="" duration="150" mode="Linear"/>
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<shader>
							<path>${themePath}/_common/shaders/border_dvd_case.glsl</path>
							<caseType>${boitiertype}</caseType>
							<borderColor>${boitiercouleur}</borderColor>
							<borderSize>0</borderSize>
							<cornerRadius>0</cornerRadius>
							<innerShadowSize>0</innerShadowSize>
							<outerShadowSize>0.02</outerShadowSize>
							<saturation>1</saturation>
							<enabled ifSubset="contourboite:non">false</enabled>
							<caseType ifSubset="typeboite:t0">0</caseType>
							<caseType ifSubset="typeboite:t1">1</caseType>
							<caseType ifSubset="typeboite:t2">2</caseType>
							<caseType ifSubset="typeboite:t3">3</caseType>
							<caseType ifSubset="typeboite:t4">4</caseType>
							<caseType ifSubset="typeboite:t5">5</caseType>
							<caseType ifSubset="typeboite:t6">6</caseType>
							<caseType ifSubset="typeboite:t7">7</caseType>
							<caseType ifSubset="typeboite:t8">8</caseType>
							<caseType ifSubset="typeboite:t9">9</caseType>
							<caseType ifSubset="typeboite:t10">10</caseType>
							<caseType ifSubset="typeboite:t11">11</caseType>
							<caseType ifSubset="typeboite:t12">12</caseType>
							<caseType ifSubset="typeboite:t13">13</caseType>
							<caseType ifSubset="typeboite:t14">14</caseType>
							<caseType ifSubset="typeboite:t15">15</caseType>
							<caseType ifSubset="typeboite:t16">16</caseType>
							<caseType ifSubset="typeboite:t17">17</caseType>
							<caseType ifSubset="typeboite:t18">18</caseType>
							<caseType ifSubset="typeboite:t19">19</caseType>
							<caseType ifSubset="typeboite:t20">20</caseType>
							<caseType ifSubset="typeboite:t21">21</caseType>
						</shader>
					</image>
					<image name="thumbnailstd" if="{system.theme} == 'snes' || {system.theme} == 'n64' || {system.theme} == 'gameandwatch' || {system.theme} == 'solarus' || {system.theme} == 'ngage'">
						<visible if="{system.theme} == 'snes' || {system.theme} == 'n64' || {system.theme} == 'gameandwatch'|| {system.theme} == 'solarus' || {system.theme} == 'ngage'">{game:region} != 'jp'</visible>
						<pos>0.5 0.6</pos>
						<origin>0.5</origin>
						<rotation>90</rotation>
						<maxSize>0.55 1</maxSize>
						<path>${media_box2d}</path>
						<path ifSubset="boxorthumb:boxart">${media_box3d}</path>
						<path ifSubset="boxorthumb:thumb">${media_box2d}</path>
						<storyboard event="open">
							<animation property="rotation" to="87" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="rotation" to="-5" begin="250" duration="250" mode="easeOut"/>
							<animation property="y" to="0.68" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="rotation" to="90" begin="" duration="150" mode="Linear"/>
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<shader>
							<path>${themePath}/_common/shaders/border_dvd_case.glsl</path>
							<caseType>${boitiertype}</caseType>
							<borderColor>${boitiercouleur}</borderColor>
							<borderSize>0</borderSize>
							<cornerRadius>0</cornerRadius>
							<innerShadowSize>0</innerShadowSize>
							<outerShadowSize>0.02</outerShadowSize>
							<saturation>1</saturation>
							<enabled ifSubset="contourboite:non">false</enabled>
							<caseType ifSubset="typeboite:t0">0</caseType>
							<caseType ifSubset="typeboite:t1">1</caseType>
							<caseType ifSubset="typeboite:t2">2</caseType>
							<caseType ifSubset="typeboite:t3">3</caseType>
							<caseType ifSubset="typeboite:t4">4</caseType>
							<caseType ifSubset="typeboite:t5">5</caseType>
							<caseType ifSubset="typeboite:t6">6</caseType>
							<caseType ifSubset="typeboite:t7">7</caseType>
							<caseType ifSubset="typeboite:t8">8</caseType>
							<caseType ifSubset="typeboite:t9">9</caseType>
							<caseType ifSubset="typeboite:t10">10</caseType>
							<caseType ifSubset="typeboite:t11">11</caseType>
							<caseType ifSubset="typeboite:t12">12</caseType>
							<caseType ifSubset="typeboite:t13">13</caseType>
							<caseType ifSubset="typeboite:t14">14</caseType>
							<caseType ifSubset="typeboite:t15">15</caseType>
							<caseType ifSubset="typeboite:t16">16</caseType>
							<caseType ifSubset="typeboite:t17">17</caseType>
							<caseType ifSubset="typeboite:t18">18</caseType>
							<caseType ifSubset="typeboite:t19">19</caseType>
							<caseType ifSubset="typeboite:t20">20</caseType>
							<caseType ifSubset="typeboite:t21">21</caseType>
						</shader>
					</image>
					<image name="thumbnail" if="{system.theme} == 'snes' || {system.theme} == 'n64' || {system.theme} == 'gameandwatch' || {system.theme} == 'solarus' || {system.theme} == 'ngage'">
						<visible>false</visible>
						<visible if="{system.theme} == 'snes' || {system.theme} == 'n64' || {system.theme} == 'gameandwatch'|| {system.theme} == 'solarus' || {system.theme} == 'ngage'">{game:region} == 'jp'</visible>
						<pos>0.5 0.6</pos>
						<origin>0.5</origin>
						<rotation>0</rotation>
						<maxSize>0.38 1</maxSize>
						<path>${media_box2d}</path>
						<path ifSubset="boxorthumb:boxart">${media_box3d}</path>
						<path ifSubset="boxorthumb:thumb">${media_box2d}</path>
						<storyboard ifSubset="starboxang:deactive" event="activate">
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:deactive" event="deactivate">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="activate">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="deactivate">
							<animation property="rotation" to="0" begin="" duration="150" mode="Linear"/>
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<shader>
							<path>${themePath}/_common/shaders/border_dvd_case.glsl</path>
							<caseType>${boitiertype}</caseType>
							<borderColor>${boitiercouleur}</borderColor>
							<borderSize>0</borderSize>
							<cornerRadius>0</cornerRadius>
							<innerShadowSize>0</innerShadowSize>
							<outerShadowSize>0.02</outerShadowSize>
							<saturation>1</saturation>
							<enabled ifSubset="contourboite:non">false</enabled>
							<caseType ifSubset="typeboite:t0">0</caseType>
							<caseType ifSubset="typeboite:t1">1</caseType>
							<caseType ifSubset="typeboite:t2">2</caseType>
							<caseType ifSubset="typeboite:t3">3</caseType>
							<caseType ifSubset="typeboite:t4">4</caseType>
							<caseType ifSubset="typeboite:t5">5</caseType>
							<caseType ifSubset="typeboite:t6">6</caseType>
							<caseType ifSubset="typeboite:t7">7</caseType>
							<caseType ifSubset="typeboite:t8">8</caseType>
							<caseType ifSubset="typeboite:t9">9</caseType>
							<caseType ifSubset="typeboite:t10">10</caseType>
							<caseType ifSubset="typeboite:t11">11</caseType>
							<caseType ifSubset="typeboite:t12">12</caseType>
							<caseType ifSubset="typeboite:t13">13</caseType>
							<caseType ifSubset="typeboite:t14">14</caseType>
							<caseType ifSubset="typeboite:t15">15</caseType>
							<caseType ifSubset="typeboite:t16">16</caseType>
							<caseType ifSubset="typeboite:t17">17</caseType>
							<caseType ifSubset="typeboite:t18">18</caseType>
							<caseType ifSubset="typeboite:t19">19</caseType>
							<caseType ifSubset="typeboite:t20">20</caseType>
