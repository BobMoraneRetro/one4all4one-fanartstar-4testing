<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${gm_box2d} : chemin du média perso « box2d » (_gamemedia/<système>/box2d/<rom>) (définie dans _common/gamemedia/gamemedia.xml)
	${gm_box3d} : chemin du média perso « box3d » (_gamemedia/<système>/box3d/<rom>) (définie dans _common/gamemedia/gamemedia.xml)
-->
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<media_box3d ifSubset="gamemedia:oui">firstfile(${gm_box3d},{game:thumbnail})</media_box3d>
		<media_box3d ifSubset="gamemedia:seul">firstfile(${gm_box3d})</media_box3d>
		<media_box3d ifSubset="gamemedia:non">{game:thumbnail}</media_box3d>
		<media_box3d_missing ifSubset="gamemedia:oui">!exists(${gm_box3d}) &amp;&amp; !exists({game:thumbnail})</media_box3d_missing>
		<media_box3d_missing ifSubset="gamemedia:seul">!exists(${gm_box3d})</media_box3d_missing>
		<media_box3d_missing ifSubset="gamemedia:non">!exists({game:thumbnail})</media_box3d_missing>
		<media_box2d ifSubset="gamemedia:oui">firstfile(${gm_box2d},{game:boxart})</media_box2d>
		<media_box2d ifSubset="gamemedia:seul">firstfile(${gm_box2d})</media_box2d>
		<media_box2d ifSubset="gamemedia:non">{game:boxart}</media_box2d>
		<media_box2d_missing ifSubset="gamemedia:oui">!exists(${gm_box2d}) &amp;&amp; !exists({game:boxart})</media_box2d_missing>
		<media_box2d_missing ifSubset="gamemedia:seul">!exists(${gm_box2d})</media_box2d_missing>
		<media_box2d_missing ifSubset="gamemedia:non">!exists({game:boxart})</media_box2d_missing>
	</variables>
</theme>
