<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${media_video_exists} : vrai si le média « video » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${sv_capturegauche_visible} : Spotlight : réglage « capturegauche_visible » selon l option vidéo (définie dans _viewgame/presetspotlight.xml ; valeur selon l option « SPOTLIGHT - Vidéo »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${presetdeck}, ${presetshowbig}, ${presetshowsmall}, ${presetspeedbull}, ${presetspotlight}, ${presetsquare}, ${presetstarbox}, ${presettraviolta_alt}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
		<image name="screenshotgames" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<image name="screenshotgames" ifSubset="starvideo:starvideoang" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
		<video name="videogameplay" ifSubset="starvideo:starvideoang" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetdeck" displayName="${presetdeck}" inherits="grid">
		<video name="deck_video" extra="true">
			<delay>0</delay>
			<effect>none</effect>
			<storyboard event="activate">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetspotlight" displayName="${presetspotlight}" inherits="grid">
		<video name="spot_video" extra="true">
			<delay>0</delay>
		</video>
		<video name="spot_videogauche" extra="true">
			<delay>0</delay>
			<effect>none</effect>
		</video>
		<image name="spot_capturegauche" extra="true">
			<visible>${sv_capturegauche_visible} &amp;&amp; !(${media_video_exists})</visible>
		</image>
	</customView>
	<customView name="presetsquare" displayName="${presetsquare}" inherits="grid">
		<video name="grid_video" extra="true">
			<delay>0</delay>
			<storyboard event="activate">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
		<image name="grid_capture" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
	</customView>
	<customView name="presetshowbig" displayName="${presetshowbig}" inherits="gamecarousel">
		<video name="previewvidpreset" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetshowsmall" displayName="${presetshowsmall}" inherits="gamecarousel">
		<video name="previewvidpreset" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presettraviolta_alt" displayName="${presettraviolta_alt}" inherits="gamecarousel">
		<video name="previewvidpreset" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetspeedbull" displayName="${presetspeedbull}" inherits="gamecarousel">
		<video name="videogame" extra="true">
			<delay>0</delay>
		</video>
	</customView>
	<customView name="presetsalon" displayName="${presetsalon}" inherits="gamecarousel">
		<video name="salonvideo" if="!${salon_video_etiree}" extra="true">
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
		<video name="salonvideoetiree" if="${salon_video_etiree}" extra="true">
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
		<video name="salonvideo2" if="${salon_ecran2} &amp;&amp; !${salon_video_etiree}" extra="true">
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
		<video name="salonvideoetiree2" if="${salon_ecran2} &amp;&amp; ${salon_video_etiree}" extra="true">
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
</theme>
