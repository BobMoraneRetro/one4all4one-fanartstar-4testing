<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${boitiercouleur} : couleur du boîtier selon le système (shader border_dvd_case) (définie dans _viewgameoption/gl-common/boitiers_systemes.xml)
	${boitiertype} : type de boîtier selon le système (shader border_dvd_case : DVD, CD, cartouche...) (définie dans _viewgameoption/gl-common/boitiers_systemes.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${media_box2d} : boîte 2D du jeu (gamelist ou média perso selon l option) (définie dans _common/gamemedia/3dinboxart.xml, _common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box2d_missing} : vrai si le média « box2d » du jeu manque (définie dans _common/gamemedia/3dinboxart.xml, _common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d} : boîte 3D du jeu (gamelist ou média perso selon l option) (définie dans _common/gamemedia/3dinboxart.xml, _common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d_missing} : vrai si le média « box3d » du jeu manque (définie dans _common/gamemedia/3dinboxart.xml, _common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee} : logo du jeu (marquee) (définie dans _common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee_missing} : vrai si le média « marquee » du jeu manque (définie dans _common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${presetstarbox}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
