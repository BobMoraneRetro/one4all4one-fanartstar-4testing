<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Modèle des vignettes de la vue grid (médias perso : capture ${media_image}, logo ${media_marquee}).
	     Reproduit les anciens états gridtile default / selected avec des animations activate (sélection) / deactivate.
	     IMPORTANT : inclus en DERNIER dans theme.xml (comme gamecarousel_items.xml), sinon il serait recopié dans les
	     customView inherits="grid" (presetsquare, presetstar169, presetstar43, presetdeck). -->
	<view name="grid">
		<imagegrid name="gamegrid">
			<itemTemplate>
				<container>
					<image name="fond">
						<path>${themePath}/_viewgame/deck/blanc.png</path>
						<pos>0 0</pos>
						<size>1 1</size>
						<color>40404080</color>
						<storyboard event="activate">
							<animation property="color" from="40404080" to="0B0102FF" duration="150" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" from="0B0102FF" to="40404080" duration="150" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="lisere">
						<path>${themePath}/_viewgame/deck/cadre_panneau.png</path>
						<pos>0 0</pos>
						<size>1 1</size>
						<color>909090FF</color>
						<opacity>0</opacity>
						<storyboard event="activate">
							<animation property="opacity" from="0" to="1" duration="150" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" from="1" to="0" duration="150" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="capture">
						<path>${media_image}</path>
						<pos>0.5 0.5</pos>
						<origin>0.5 0.5</origin>
						<minSize>0.952 0.92</minSize>
						<color>6D6D6DFF</color>
						<linearSmooth>true</linearSmooth>
						<storyboard event="activate">
							<animation property="color" from="6D6D6DFF" to="FFFFFFFF" duration="150" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" from="FFFFFFFF" to="6D6D6DFF" duration="150" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="logo">
						<path>${media_marquee}</path>
						<pos>0.5 0.5</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.6 0.6</maxSize>
						<color>DADADAFF</color>
						<linearSmooth>true</linearSmooth>
						<storyboard event="activate">
							<animation property="color" from="DADADAFF" to="FFFFFFFF" duration="150" mode="easeOut"/>
							<animation property="scale" from="1" to="1.5" duration="150" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" from="FFFFFFFF" to="DADADAFF" duration="150" mode="easeOut"/>
							<animation property="scale" from="1.5" to="1" duration="150" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="favori">
						<visible>{game:favorite}</visible>
						<path>${themePath}/_viewgameoption/gl-common/infoicone/yesfull.png</path>
						<pos>0.855 0</pos>
						<origin>0 0</origin>
						<maxSize>0.25 0.25</maxSize>
						<color>FFFFFFFF</color>
						<storyboard event="activate">
							<animation property="color" from="FFFFFFFF" to="FFFF00FF" duration="150" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" from="FFFF00FF" to="FFFFFFFF" duration="150" mode="easeOut"/>
						</storyboard>
					</image>
				</container>
			</itemTemplate>
		</imagegrid>
	</view>
</theme>
