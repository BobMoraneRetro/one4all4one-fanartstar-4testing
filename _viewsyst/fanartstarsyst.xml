<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${firstscharsystem} : Vue système classique, option Personnages : personnage du système, sinon figurine Animatics (définie dans theme.xml)
	${firstsnapouille} : Vue système classique, option Figurines : figurine Animatics, sinon personnage du système (définie dans theme.xml)
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${manettechemin} : image de la manette du système : version de la région, sinon PNG, sinon SVG (_common/controllers) (définie dans ce fichier)
	${manettehalopos} : position du halo sous la manette flottante (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Vidéo de gameplay sur la vue système »)
	${manettehalotaille} : taille du halo sous la manette flottante (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Vidéo de gameplay sur la vue système »)
	${manettehalovisible} : halo sous la manette flottante : seulement si l option est activée ET si le système a une image de manette (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Manette flottante (vue classique) »)
	${manettepos} : position de la manette flottante (coin haut gauche si vidéo, place de la vidéo sinon) (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Vidéo de gameplay sur la vue système »)
	${manettetaille} : taille de la manette flottante (petite si vidéo, grande sinon) (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Vidéo de gameplay sur la vue système »)
	${manettevisible} : manette flottante affichée (option SYSTÈMES - Manette flottante) (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Manette flottante (vue classique) »)
	${metaanneepolice} : taille de l année et du fabricant, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metaanneepos} : position de l année, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metadescpolice} : taille de police de la description du système, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metadescpos} : position de la description du système, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metadescsize} : taille du bloc description du système, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metafabpos} : position du fabricant, vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metastatscompacte} : opacité des statistiques sur 4 lignes (présentation compacte) (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : affichées (vue classique) », « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metastatsstandard} : opacité des statistiques sur 2 lignes (présentation standard) (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : affichées (vue classique) », « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${metatitrepolice} : taille du titre du système (nom + nombre de jeux), vue classique (définie dans ce fichier ; valeur selon l option « SYSTÈMES - Infos du système : présentation (vue classique) »)
	${path_common} : dossier _common du thème (définie dans theme.xml)
	${path_syst_logo} : dossier des logos des systèmes (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des systèmes »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${jeux}
-->
<theme>
	<formatVersion>7</formatVersion>
	<include>${themePath}/_systemmedia/description/${system.theme}.xml</include>
	<variables>
		<manettevisible ifSubset="manetteflottante:manettenon">false</manettevisible>
		<manettevisible ifSubset="manetteflottante:manetteoui">true</manettevisible>
		<manettehalovisible ifSubset="manetteflottante:manettenon">false</manettehalovisible>
		<manettehalovisible ifSubset="manetteflottante:manetteoui">exists("${themePath}/_common/controllers/${region}/" + {system:theme} + ".png") || exists("${themePath}/_common/controllers/${region}/" + {system:theme} + ".svg") || exists("${themePath}/_common/controllers/" + {system:theme} + ".png") || exists("${themePath}/_common/controllers/" + {system:theme} + ".svg")</manettehalovisible>
		<manettehalovisible ifSubset="manetteflottante:manetteoui" if="{system.hardwareType} == 'arcade'">exists("${themePath}/_systemmedia/hardware/${region}/" + {system:theme} + ".png") || exists("${themePath}/_systemmedia/hardware/" + {system:theme} + ".png") || exists("${themePath}/_common/controllers/${region}/" + {system:theme} + ".png") || exists("${themePath}/_common/controllers/${region}/" + {system:theme} + ".svg") || exists("${themePath}/_common/controllers/" + {system:theme} + ".png") || exists("${themePath}/_common/controllers/" + {system:theme} + ".svg")</manettehalovisible>
		<manettechemin>firstfile("${themePath}/_common/controllers/${region}/" + {system:theme} + ".png", "${themePath}/_common/controllers/${region}/" + {system:theme} + ".svg", "${themePath}/_common/controllers/" + {system:theme} + ".png", "${themePath}/_common/controllers/" + {system:theme} + ".svg")</manettechemin>
		<manettechemin if="{system.hardwareType} == 'arcade'">firstfile("${themePath}/_systemmedia/hardware/${region}/" + {system:theme} + ".png", "${themePath}/_systemmedia/hardware/" + {system:theme} + ".png", "${themePath}/_common/controllers/${region}/" + {system:theme} + ".png", "${themePath}/_common/controllers/${region}/" + {system:theme} + ".svg", "${themePath}/_common/controllers/" + {system:theme} + ".png", "${themePath}/_common/controllers/" + {system:theme} + ".svg")</manettechemin>
		<manettepos ifSubset="video4starclassic:videoback">0.036 0.088</manettepos>
		<manettepos ifSubset="video4starclassic:novideo">0.13 0.58</manettepos>
		<manettetaille ifSubset="video4starclassic:videoback">0.067 0.08</manettetaille>
		<manettetaille ifSubset="video4starclassic:novideo">0.17 0.17</manettetaille>
		<manettehalopos ifSubset="video4starclassic:videoback">0.036 0.138</manettehalopos>
		<manettehalopos ifSubset="video4starclassic:novideo">0.13 0.68</manettehalopos>
		<manettehalotaille ifSubset="video4starclassic:videoback">0.058 0.014</manettehalotaille>
		<manettehalotaille ifSubset="video4starclassic:novideo">0.14 0.03</manettehalotaille>
		<metatitrepolice ifSubset="metasyst:metastandard">0.025</metatitrepolice>
		<metatitrepolice ifSubset="metasyst:metacompacte">0.019</metatitrepolice>
		<metaanneepolice ifSubset="metasyst:metastandard">0.025</metaanneepolice>
		<metaanneepolice ifSubset="metasyst:metacompacte">0.017</metaanneepolice>
		<metaanneepos ifSubset="metasyst:metastandard">0.253 0.28</metaanneepos>
		<metaanneepos ifSubset="metasyst:metacompacte">0.253 0.264</metaanneepos>
		<metafabpos ifSubset="metasyst:metastandard">0.3 0.28</metafabpos>
		<metafabpos ifSubset="metasyst:metacompacte">0.288 0.264</metafabpos>
		<metafabpos ifSubset="metasyst:metastandard" if="${screen.ratio} == '4/3'">0.315 0.28</metafabpos>
		<metafabpos ifSubset="metasyst:metacompacte" if="${screen.ratio} == '4/3'">0.293 0.264</metafabpos>
		<metadescpos ifSubset="metasyst:metastandard">0.0525 0.305</metadescpos>
		<metadescpos ifSubset="metasyst:metacompacte">0.0525 0.283</metadescpos>
		<metadescsize ifSubset="metasyst:metastandard">0.4 0.1</metadescsize>
		<metadescsize ifSubset="metasyst:metacompacte">0.33 0.085</metadescsize>
		<metadescsize ifSubset="metasyst:metastandard" if="${screen.ratio} == '4/3'">0.533 0.1</metadescsize>
		<metadescsize ifSubset="metasyst:metacompacte" if="${screen.ratio} == '4/3'">0.44 0.085</metadescsize>
		<metadescpolice ifSubset="metasyst:metastandard">0.022</metadescpolice>
		<metadescpolice ifSubset="metasyst:metacompacte">0.016</metadescpolice>
		<metastatsstandard ifSubset="metasyst:metastandard">1</metastatsstandard>
		<metastatsstandard ifSubset="metasyst:metacompacte">0</metastatsstandard>
		<metastatscompacte ifSubset="metasyst:metastandard">0</metastatscompacte>
		<metastatscompacte ifSubset="metasyst:metacompacte">1</metastatscompacte>
		<metastatsstandard ifSubset="metadataonoff:deactivate">0</metastatsstandard>
		<metastatscompacte ifSubset="metadataonoff:deactivate">0</metastatscompacte>
	</variables>
	<view name="system">
		<carousel name="systemcarousel">
			<scrollSound ifSubset="gamewheelsound:bulle">${path_common}/scrollsound/bulle.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clic">${path_common}/scrollsound/clic.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clicgrave">${path_common}/scrollsound/clicgrave.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:frottement">${path_common}/scrollsound/frottement.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:poc">${path_common}/scrollsound/poc.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360blade">${path_common}/scrollsound/xbox360-BladeSwitch_1.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360onglet">${path_common}/scrollsound/xbox360-tab_Switch.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360focus">${path_common}/scrollsound/xbox360-vk_Focus.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360touche">${path_common}/scrollsound/xbox360-vk_Select.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360retour">${path_common}/scrollsound/xbox360-btn_backG.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360selection">${path_common}/scrollsound/xbox360-snd_buttonselect.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:wheelclic">${path_common}/scrollsound/wheelclic.wav</scrollSound>
			<zIndex>10</zIndex>
			<type>horizontal</type>
			<pos>-0.015 0.08</pos>
			<pos ifHelpPrompts="true">-0.014 0.08</pos>
			<size>1.375 1</size>
			<logoScale ifSubset="systviewselec:charsystem">1.5</logoScale>
			<logoScale ifSubset="systviewselec:figurines">1.5</logoScale>
			<logoScale ifSubset="systviewselec:rondhursty">1.5</logoScale>
			<logoScale ifSubset="systviewselec:hardware">1.5</logoScale>
			<logoScale ifSubset="systviewselec:logosseuls">1.3</logoScale>
			<logoSize>0.350 0.350</logoSize>
			<color>00000000</color>
			<logoAlignment>bottom</logoAlignment>
			<minLogoOpacity>1</minLogoOpacity>
			<transitionSpeed>750</transitionSpeed>
			<logoPos>0.15 0.5</logoPos>
			<imageSource>thumbnail</imageSource>
			<defaultTransition>instant</defaultTransition>
			<logoRotation>1</logoRotation>
			<logoRotationOrigin>0 1</logoRotationOrigin>
			<maxLogoCount>11</maxLogoCount>
			<itemTemplate>
				<container>
					<image name="shadohard">
						<visible ifSubset="systviewselec:charsystem">true</visible>
						<visible ifSubset="systviewselec:figurines">true</visible>
						<visible ifSubset="systviewselec:rondhursty">false</visible>
						<visible ifSubset="systviewselec:hardware">true</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<pos>0.5 0.55</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.4 0.4</maxSize>
						<maxSize ifSubset="systviewselec:figurines">0.55 0.55</maxSize>
						<maxSize ifSubset="systviewselec:charsystem">0.35 0.55</maxSize>
						<maxSize ifSubset="systviewselec:hardware">0.35 0.35</maxSize>
						<path ifSubset="systviewselec:charsystem">${firstscharsystem}</path>
						<path ifSubset="systviewselec:figurines">${firstsnapouille}</path>
						<path ifSubset="systviewselec:hardware">${firstsystemhardware}</path>
						<saturation>1</saturation>
						<zIndex>5</zIndex>
						<padding>3 3 -3 -3</padding>
						<color>000000</color>
					</image>
					<image name="hardware">
						<visible ifSubset="systviewselec:charsystem">true</visible>
						<visible ifSubset="systviewselec:figurines">true</visible>
						<visible ifSubset="systviewselec:rondhursty">false</visible>
						<visible ifSubset="systviewselec:hardware">true</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<pos>0.5 0.55</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.4 0.4</maxSize>
						<maxSize ifSubset="systviewselec:figurines">0.55 0.55</maxSize>
						<maxSize ifSubset="systviewselec:charsystem">0.35 0.55</maxSize>
						<maxSize ifSubset="systviewselec:hardware">0.35 0.35</maxSize>
						<path ifSubset="systviewselec:charsystem">${firstscharsystem}</path>
						<path ifSubset="systviewselec:figurines">${firstsnapouille}</path>
						<path ifSubset="systviewselec:hardware">${firstsystemhardware}</path>
						<saturation>0.7</saturation>
						<zIndex>5</zIndex>
					</image>
					<image name="rondombre">
						<visible ifSubset="systviewselec:charsystem">false</visible>
						<visible ifSubset="systviewselec:figurines">false</visible>
						<visible ifSubset="systviewselec:rondhursty">true</visible>
						<visible ifSubset="systviewselec:hardware">false</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<path>firstfile("${path_syst_logo}/roundsilver/" + {system:theme} + ".png", "${path_syst_logo}/roundsilver/_defaut/defaut.png")</path>
						<pos>0.5 0.74</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.6 0.6</maxSize>
						<padding>3 3 -3 -3</padding>
						<color>000000</color>
						<zIndex>5</zIndex>
						<storyboard event="activate">
							<animation property="y" to="0.64" duration="250" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="y" to="0.74" duration="250" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="rond">
						<visible ifSubset="systviewselec:charsystem">false</visible>
						<visible ifSubset="systviewselec:figurines">false</visible>
						<visible ifSubset="systviewselec:rondhursty">true</visible>
						<visible ifSubset="systviewselec:hardware">false</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<path>firstfile("${path_syst_logo}/roundsilver/" + {system:theme} + ".png", "${path_syst_logo}/roundsilver/_defaut/defaut.png")</path>
						<pos>0.5 0.74</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.6 0.6</maxSize>
						<linearSmooth>true</linearSmooth>
						<zIndex>5</zIndex>
						<storyboard event="activate">
							<animation property="y" to="0.64" duration="250" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="y" to="0.74" duration="250" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="rondconsole">
						<visible ifSubset="systviewselec:charsystem">false</visible>
						<visible ifSubset="systviewselec:figurines">false</visible>
						<visible ifSubset="systviewselec:rondhursty">!exists("${path_syst_logo}/roundsilver/" + {system:theme} + ".png")</visible>
						<visible ifSubset="systviewselec:hardware">false</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<path>firstfile("${themePath}/_systemmedia/hardware/${region}/" + {system:theme} + ".png", "${themePath}/_systemmedia/hardware/" + {system:theme} + ".png", "${themePath}/_systemmedia/charsystem/" + {system:theme} + ".png")</path>
						<pos>0.5 0.70</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.34 0.26</maxSize>
						<linearSmooth>true</linearSmooth>
						<saturation>0.8</saturation>
						<zIndex>5.5</zIndex>
						<storyboard event="activate">
							<animation property="y" to="0.6" duration="250" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="y" to="0.70" duration="250" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="rondnom">
						<visible ifSubset="systviewselec:charsystem">false</visible>
						<visible ifSubset="systviewselec:figurines">false</visible>
						<visible ifSubset="systviewselec:rondhursty">!exists("${path_syst_logo}/roundsilver/" + {system:theme} + ".png")</visible>
						<visible ifSubset="systviewselec:hardware">false</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<path>firstfile("${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png", "${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png", "${path_syst_logo}/clearlogos/" + {system:theme} + ".png", "${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</path>
						<pos>0.5 0.86</pos>
						<origin>0.5 0.5</origin>
						<maxSize>0.40 0.11</maxSize>
						<linearSmooth>true</linearSmooth>
						<zIndex>5.6</zIndex>
						<storyboard event="activate">
							<animation property="y" to="0.76" duration="250" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="y" to="0.86" duration="250" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="shadowlogo" pos="0.5 0.9" origin="0.5" maxSize="0.2" linearSmooth="true">
						<pos ifSubset="systviewselec:charsystem">0.5 0.9</pos>
						<pos ifSubset="systviewselec:figurines">0.5 0.9</pos>
						<pos ifSubset="systviewselec:rondhursty">0.5 0.9</pos>
						<pos ifSubset="systviewselec:hardware">0.5 0.9</pos>
						<pos ifSubset="systviewselec:logosseuls">0.5 0.87</pos>
						<visible ifSubset="systviewselec:rondhursty">false</visible>
						<visible ifSubset="systviewselec:charsystem">true</visible>
						<visible ifSubset="systviewselec:figurines">true</visible>
						<visible ifSubset="systviewselec:hardware">true</visible>
						<visible ifSubset="systviewselec:logosseuls">true</visible>
						<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</path>
						<padding>3 3 -3 -3</padding>
						<color>000000</color>
						<zIndex>6</zIndex>
					</image>
					<image name="logo" extra="true" pos="0.5 0.9" origin="0.5" maxSize="0.2" linearSmooth="true">
						<pos ifSubset="systviewselec:charsystem">0.5 0.9</pos>
						<pos ifSubset="systviewselec:figurines">0.5 0.9</pos>
						<pos ifSubset="systviewselec:rondhursty">0.5 0.9</pos>
						<pos ifSubset="systviewselec:hardware">0.5 0.9</pos>
						<pos ifSubset="systviewselec:logosseuls">0.5 0.87</pos>
						<visible ifSubset="systviewselec:rondhursty">false</visible>
						<visible ifSubset="systviewselec:charsystem">true</visible>
						<visible ifSubset="systviewselec:figurines">true</visible>
						<visible ifSubset="systviewselec:hardware">true</visible>
						<visible ifSubset="systviewselec:logosseuls">false</visible>
						<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</path>
						<zIndex>7</zIndex>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="858585ff" begin="" mode="Linear"/>
						</storyboard>
					</image>
					<image name="logogris" extra="true" pos="0.5 0.9" origin="0.5" maxSize="0.2" linearSmooth="true">
						<pos ifSubset="systviewselec:charsystem">0.5 0.9</pos>
						<pos ifSubset="systviewselec:figurines">0.5 0.9</pos>
						<pos ifSubset="systviewselec:rondhursty">0.5 0.9</pos>
						<pos ifSubset="systviewselec:hardware">0.5 0.9</pos>
						<pos ifSubset="systviewselec:logosseuls">0.5 0.87</pos>
						<visible ifSubset="systviewselec:rondhursty">false</visible>
						<visible ifSubset="systviewselec:charsystem">false</visible>
